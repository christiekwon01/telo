# Copy to `.env` and replace every value below with real credentials (never commit `.env`).
# Run `npm run prebuild:check` before EAS builds to verify keys are set.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-real-anon-jwt
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-...your-real-key

# Optional: Apple Calendar edge function (leave empty if unused)
EXPO_PUBLIC_APPLE_CALENDAR_SUBSCRIPTION_URL=

# For `npm run gen:types` — run `npx supabase login` once, or export a personal access token:
# SUPABASE_ACCESS_TOKEN=
